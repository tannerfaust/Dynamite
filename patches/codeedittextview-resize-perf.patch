+    /// Re-wraps once after the editor width stops changing.
+    private func scheduleFinalWrapRelayout() {
+        wrapWidthRelayoutWorkItem?.cancel()
+
+        let workItem = DispatchWorkItem { [weak self] in
+            guard let self else { return }
+            self.wrapWidthRelayoutWorkItem = nil
+            self.wrapWidthLiveRelayoutWorkItem?.cancel()
+            self.wrapWidthLiveRelayoutWorkItem = nil
+            guard self.layoutManager.frozenWrapWidth != nil else { return }
+
+            self.layoutManager.frozenWrapWidth = nil
+            self.needsLayout = true
+            self.needsDisplay = true
+            self.layoutManager.setNeedsLayout()
+            self.layoutManager.layoutLines()
+            self.selectionManager.updateSelectionViews(skipTimerReset: true)
+            _ = self.updateFrameIfNeeded()
+        }
+
+        wrapWidthRelayoutWorkItem = workItem
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.12, execute: workItem)
+    }
 }
diff --git a/Sources/CodeEditTextView/TextView/TextView+Lifecycle.swift b/Sources/CodeEditTextView/TextView/TextView+Lifecycle.swift
index 812919d..ddc53de 100644
--- a/Sources/CodeEditTextView/TextView/TextView+Lifecycle.swift
+++ b/Sources/CodeEditTextView/TextView/TextView+Lifecycle.swift
@@ -23,8 +23,28 @@ extension TextView {
         setUpScrollListeners(scrollView: scrollView)
     }
 
+    override public func viewWillStartLiveResize() {
+        super.viewWillStartLiveResize()
+        // Freeze the line-wrapping width for the duration of the live resize. Otherwise the viewport width
+        // changes on every frame and every visible line is re-typeset each frame, pegging a CPU core and
+        // dropping the resize to a few FPS. We re-wrap once in `viewDidEndLiveResize`.
+        if layoutManager.wrapLines {
+            layoutManager.frozenWrapWidth = layoutManager.wrapLinesWidth
+        }
+    }
+
     override public func viewDidEndLiveResize() {
         super.viewDidEndLiveResize()
+        wrapWidthLiveRelayoutWorkItem?.cancel()
+        wrapWidthLiveRelayoutWorkItem = nil
+        wrapWidthRelayoutWorkItem?.cancel()
+        wrapWidthRelayoutWorkItem = nil
+        // Unfreeze and perform a single re-wrap pass at the final width.
+        if layoutManager.frozenWrapWidth != nil {
+            layoutManager.frozenWrapWidth = nil
+            layoutManager.setNeedsLayout()
+            layoutManager.layoutLines()
+        }
         updateFrameIfNeeded()
     }
 }
