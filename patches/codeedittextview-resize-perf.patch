diff --git a/Sources/CodeEditTextView/TextLine/FastID.swift b/Sources/CodeEditTextView/TextLine/FastID.swift
new file mode 100644
index 0000000..87502a2
--- /dev/null
+++ b/Sources/CodeEditTextView/TextLine/FastID.swift
@@ -0,0 +1,40 @@
+//
+//  FastID.swift
+//  CodeEditTextView
+//
+//  Fast, process-unique identifier generation for layout objects.
+//
+//  Swift's `UUID()` calls `uuid_generate_random`, which draws from the system
+//  CSPRNG (an AES-CTR DRBG in corecrypto). During a live window/pane resize the
+//  layout system re-typesets every visible line on each frame, allocating
+//  thousands of `LineFragment` / `TextLine` instances. Minting a cryptographic
+//  UUID for each one makes the CSPRNG dominate CPU and pegs a core, which shows
+//  up as a few-FPS stutter while resizing or dragging split dividers.
+//
+//  These identifiers only need to be unique within the running process, so we
+//  mint them from a monotonic counter instead. The result is still a `UUID`
+//  (preserving all existing API and `Identifiable`/`Hashable` usage) but costs
+//  a single atomic increment instead of a crypto draw.
+//
+
+import Foundation
+import os
+
+enum FastID {
+    private static let counter = OSAllocatedUnfairLock(initialState: UInt64(0))
+
+    /// Returns a process-unique `UUID` backed by a monotonic counter (no CSPRNG).
+    static func next() -> UUID {
+        let value = counter.withLock { state -> UInt64 in
+            state &+= 1
+            return state
+        }
+        let bytes = withUnsafeBytes(of: value.bigEndian, Array.init)
+        // Fixed prefix ("CEED7E") marks these as CodeEditTextView sequential ids;
+        // the low 8 bytes carry the counter, guaranteeing in-process uniqueness.
+        return UUID(uuid: (
+            0xCE, 0xED, 0x7E, 0x00, 0x00, 0x00, 0x00, 0x00,
+            bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7]
+        ))
+    }
+}
