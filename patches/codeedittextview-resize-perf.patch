+
+    /// Keeps wrapped line layout under our control while AppKit is actively resizing this text view.
+    ///
+    /// `viewWillStartLiveResize` only covers full-window live resize. Split-view divider drags and sidebar
+    /// collapse animations still change the text view width repeatedly without that callback. We record the latest
+    /// desired wrap width here, then re-wrap at a bounded cadence instead of on every AppKit layout pass.
+    private func updateLiveWrapWidthForResize(availableWidth: CGFloat) {
+        guard wrapLines else { return }
+        let width = availableWidth - layoutManager.edgeInsets.horizontal
+        guard width.isFinite, width > 0 else { return }
