@@ -27,10 +27,25 @@ open class LineFragmentView: NSView {

     public override init(frame frameRect: NSRect) {
         super.init(frame: frameRect)
+        configureLayer()
     }

     required public init?(coder: NSCoder) {
         super.init(coder: coder)
+        configureLayer()
+    }
+
+    /// Give every fragment its own backing layer.
+    ///
+    /// Without this, fragment views draw into the parent text view's shared layer. On some macOS
+    /// versions, when a fragment is re-laid-out, moved, or retired during a re-wrap, the pixels it
+    /// previously drew into that shared backing are not reliably cleared — leaving "ghost"
+    /// duplicated text on wrapped lines (e.g. the next line's first word clipped at the end of the
+    /// line above it). An independent, opaque-redraw layer per fragment lets Core Animation
+    /// composite and clear each fragment cleanly, eliminating the ghosting.
+    private func configureLayer() {
+        wantsLayer = true
+        layerContentsRedrawPolicy = .onSetNeedsDisplay
     }

