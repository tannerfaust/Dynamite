diff --git a/Tests/CodeEditTextViewTests/TypesetterTests.swift b/Tests/CodeEditTextViewTests/TypesetterTests.swift
index 92826c3..ca7e8d8 100644
--- a/Tests/CodeEditTextViewTests/TypesetterTests.swift
+++ b/Tests/CodeEditTextViewTests/TypesetterTests.swift
@@ -284,4 +284,54 @@ class TypesetterTests: XCTestCase {

         XCTAssertEqual(typesetter.lineFragments.count, 1)
     }
+
+    // MARK: - Wrapped fragment CTLine ranges (Dynamite regression)
+
+    /// Regression test: every wrapped fragment's CTLine must cover exactly the fragment's range.
+    ///
+    /// `suggestLineBreak` returns an offset relative to the run start, not a count. Using that offset as
+    /// the CTLine *length* built every fragment after the first too long — the oversized CTLine re-drew
+    /// the next fragment's text past the break point ("duplicated wrapped text near the right edge" on
+    /// lines wrapped to 3+ rows) and corrupted hit-testing near the wrap boundary.
+    func test_wrappedFragmentCTLinesMatchFragmentRanges() throws {
+        let text = String(
+            repeating: "The quick brown fox jumps over the lazy dog. ",
+            count: 8
+        )
+        for strategy in [LineBreakStrategy.character, .word] {
+            typesetter.typeset(
+                NSAttributedString(string: text, attributes: attributes),
+                documentRange: NSRange(location: 0, length: (text as NSString).length),
+                displayData: TextLine.DisplayData(
+                    maxWidth: 150,
+                    lineHeightMultiplier: 1.0,
+                    estimatedLineHeight: 20.0,
+                    breakStrategy: strategy
+                ),
+                markedRanges: nil,
+                attachments: []
+            )
+
+            // The narrow width must produce a multi-fragment (3+) wrap, or this test checks nothing.
+            XCTAssertGreaterThan(typesetter.lineFragments.count, 2, "Expected a 3+ row wrap (\(strategy))")
+
+            for fragment in typesetter.lineFragments {
+                XCTAssertEqual(fragment.data.contents.count, 1, "Plain text should be one content run")
+                guard case .text(let ctLine) = fragment.data.contents[0].data else {
+                    XCTFail("Expected text content")
+                    return
+                }
+                let ctRange = CTLineGetStringRange(ctLine)
+                XCTAssertEqual(
+                    ctRange.location, fragment.range.location,
+                    "CTLine must start at the fragment start (\(strategy))"
+                )
+                XCTAssertEqual(
+                    ctRange.length, fragment.range.length,
+                    "CTLine must cover exactly the fragment's characters — no overflow into the "
+                    + "next wrapped row (\(strategy))"
+                )
+            }
+        }
+    }
 }
