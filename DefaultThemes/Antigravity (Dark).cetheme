{
  "name": "antigravity.dark",
  "displayName": "Antigravity (Dark)",
  "description": "A sleek, premium deep-space dark theme for the Antigravity code editor.",
  "author": "Antigravity",
  "version": "1.0.0",
  "license": "MIT",
  "distributionURL": "https://github.com/CodeEditApp/CodeEdit",
  "type": "dark",
  "editor": {
    "background": {
      "color": "#0C0D12"
    },
    "selection": {
      "color": "#2A2E3D"
    },
    "insertionPoint": {
      "color": "#00E5FF"
    },
    "lineHighlight": {
      "color": "#151821"
    },
    "invisibles": {
      "color": "#393E53"
    },
    "text": {
      "color": "#E5E9F0"
    },
    "comments": {
      "color": "#6272A4"
    },
    "strings": {
      "color": "#50FA7B"
    },
    "characters": {
      "color": "#F1FA8C"
    },
    "numbers": {
      "color": "#BD93F9"
    },
    "keywords": {
      "color": "#FF79C6",
      "bold": true
    },
    "attributes": {
      "color": "#8BE9FD"
    },
    "types": {
      "color": "#FFB86C"
    },
    "variables": {
      "color": "#F8F8F2"
    },
    "commands": {
      "color": "#FF5555"
    },
    "values": {
      "color": "#BD93F9"
    }
  },
  "terminal": {
    "background": {
      "color": "#0C0D12"
    },
    "selection": {
      "color": "#2A2E3D"
    },
    "cursor": {
      "color": "#00E5FF"
    },
    "text": {
      "color": "#E5E9F0"
    },
    "boldText": {
      "color": "#FFFFFF"
    },
    "black": {
      "color": "#1F2024"
    },
    "red": {
      "color": "#FF5555"
    },
    "green": {
      "color": "#50FA7B"
    },
    "yellow": {
      "color": "#F1FA8C"
    },
    "blue": {
      "color": "#BD93F9"
    },
    "magenta": {
      "color": "#FF79C6"
    },
    "cyan": {
      "color": "#8BE9FD"
    },
    "white": {
      "color": "#BFBFBF"
    },
    "brightBlack": {
      "color": "#8E8E93"
    },
    "brightRed": {
      "color": "#FF6E6E"
    },
    "brightGreen": {
      "color": "#69FF94"
    },
    "brightYellow": {
      "color": "#FFFFA5"
    },
    "brightBlue": {
      "color": "#D6ACFF"
    },
    "brightMagenta": {
      "color": "#FF92DF"
    },
    "brightCyan": {
      "color": "#A4FFFF"
    },
    "brightWhite": {
      "color": "#FFFFFF"
    }
  }
}
