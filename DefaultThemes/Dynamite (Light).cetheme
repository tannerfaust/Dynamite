      "color": "#F0FAF5"
    },
    "selection": {
      "color": "#C4F5E2"
    },
    "cursor": {
      "color": "#042F1A"
    },
    "text": {
      "color": "#042F1A"
    },
    "boldText": {
      "color": "#022C22"
    },
    "black": {
      "color": "#042F1A"
    },
    "red": {
      "color": "#DC2626"
    },
    "green": {
      "color": "#059669"
    },
    "yellow": {
      "color": "#D97706"
    },
    "blue": {
      "color": "#0F52BA"
    },
    "magenta": {
      "color": "#6D28D9"
    },
    "cyan": {
      "color": "#0E7490"
    },
