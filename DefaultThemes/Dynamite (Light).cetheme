{
  "name": "dynamite.light",
  "displayName": "Dynamite (Light)",
  "description": "Project Hail Mary light theme.",
  "author": "CodeEdit",
  "version": "1.0.0",
  "license": "MIT",
  "distributionURL": "https://github.com/CodeEditApp/CodeEdit",
  "type": "light",
  "editor": {
    "background": {
      "color": "#F0FAF5"
    },
